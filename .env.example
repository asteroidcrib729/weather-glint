OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=120

# MET Norway forecast identity. Keep the project URL/contact reachable.
MET_NORWAY_USER_AGENT=WeatherGlint/1.0 (+https://github.com/asteroidcrib729/weather-glint)
# Optional startup probe; disabled for normal use.
MET_NORWAY_PILOT_ON_STARTUP=false
